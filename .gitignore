# ── 凭据：绝对不入库 ──────────────────────────────────────────────
# 只有模板 tutorial_agsc_reme/reference/.env.example 进库（里面全是占位符）
.env
*.env
!.env.example

# ── 第三方库：不入库 ─────────────────────────────────────────────
# third_party/ 是 agentscope 与 ReMe 两个独立仓库的克隆（171MB，且自带 .git），
# 按根 README 的「环境（三步）」自行克隆即可。
third_party/

# ── 运行期产物 ──────────────────────────────────────────────────
logs/
.harness/
.pytest_cache/
__pycache__/
*.py[cod]

# ── 编辑器 / 系统 ───────────────────────────────────────────────
.vscode/
.DS_Store
